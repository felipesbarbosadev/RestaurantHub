    {
      "name": "Testes do Edital",
      "item": [
        {
          "name": "T01 - Login válido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const resposta = pm.response.json();",
                  "",
                  "pm.collectionVariables.set(\"token\", resposta.accessToken);",
                  "",
                  "pm.test(\"Login realizado com sucesso\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Access token foi retornado\", function () {",
                  "    pm.expect(resposta.accessToken).to.exist;",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
